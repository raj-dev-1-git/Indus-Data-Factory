# ── Ollama Configuration ──────────────────────────────────────────
# Path to the Ollama binary (if not on PATH)
OLLAMA_EXE=ollama

# Ollama host URL (used by the Ollama CLI and API)
OLLAMA_HOST=http://ollama:11434

# LLM model identifier for the reasoning engine
OLLAMA_MODEL=qwen2.5:1.5b

# ── Whisper Configuration ────────────────────────────────────────
# Model size: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=large-v3

# Device: cpu or cuda
WHISPER_DEVICE=cpu

# Compute type: int8, float16, float32
WHISPER_COMPUTE_TYPE=int8

# ── PANNs Configuration ─────────────────────────────────────────
# Device for PANNs CNN14 inference: cpu or cuda
PANNS_DEVICE=cpu

# ── Server Configuration ────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
